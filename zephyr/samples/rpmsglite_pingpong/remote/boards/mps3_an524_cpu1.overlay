/ {
	chosen {
		/*
		 * shared memory reserved for the inter-processor communication
		 */
		zephyr,ipc_shm = &sramx;
		zephyr,ipc = &mhu0;
	};

	/* top 32 KB of the BRAM, non-secure alias.
	 * The addresses must match the cpu0 overlay exactly. */
	sramx: memory@28078000 {
		compatible = "mmio-sram";
		reg = <0x28078000 0x8000>;
	};
};
